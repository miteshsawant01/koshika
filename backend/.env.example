# =============================================================
# STEMBRIDGE AI - Supabase & Environment Configuration
# =============================================================
# Fill in your Supabase details below and rename/copy this to .env

# -------------------------------------------------------------
# 1. Supabase PostgreSQL Connection String (RECOMMENDED)
# -------------------------------------------------------------
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Option A: Session Pooler (IPv4 Compatible, Recommended for all environments)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Option B: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option C: Transaction Pooler (Port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=

# -------------------------------------------------------------
# 2. Alternative: Individual Supabase Parameters
# -------------------------------------------------------------
# SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.[YOUR-PROJECT-REF]
# SUPABASE_DB_PASSWORD=[YOUR-PASSWORD]
# SUPABASE_DB_NAME=postgres

# -------------------------------------------------------------
# 3. Supabase Project API (Optional - for direct frontend/SDK usage)
# -------------------------------------------------------------
# Found in Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-ANON-OR-SERVICE-KEY]

# -------------------------------------------------------------
# 4. Django & AI Assistant Settings
# -------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-stembridge-supabase-ai-secret-key-2026
GEMINI_API_KEY=AIzaSy-DEMO-KEY-FOR-TESTING-ONLY
